#!/usr/bin/env bash
#
# Fetch the pinned, real bundled assets for one platform (issue #19).
#
# Downloads the exact upstream artifacts named in the pin table below,
# verifies EVERY download against its pinned SHA-256 (fail-closed: a
# mismatched byte is a hard error, the overlay is never partially
# populated), and lays the platform's asset set out in the gitignored
# `assets/real/v1/` overlay. The next build embeds that overlay instead
# of the committed fixture bundle (see build.rs and docs/packaging.md).
#
# This is a PACKAGING-TIME step: it runs on the machine that builds a
# release, never on the machine that runs chilli-pdf — the app itself
# never touches the network. Development without this script (and
# without a network) keeps working on the committed fixtures.
#
# Usage:
#   scripts/fetch-assets [--platform linux64|macos|windows64]
#
# `--platform` defaults to the machine running the script. `macos` pins
# the arm64 (Apple Silicon) artifacts because that is what the release
# workflow builds on; see docs/packaging.md before changing that.
#
# Tesseract and Leptonica are our own relocated prebuilts (issues #19
# and #42), built from pinned upstream sources by the `native-libs`
# workflow and published on this repository's `ocr-prebuilts-1`
# release; the pin table below and docs/packaging.md record the
# provenance.

set -euo pipefail

# ---------------------------------------------------------------------------
# Pin table (issue #19). Bump pins here and only here; see
# docs/packaging.md for the re-pinning procedure.
# ---------------------------------------------------------------------------

# PDFium — bblanchon/pdfium-binaries, release tag `chromium/8100`
# (PDFium 157.0.8100.0, published 2026-10-12).
PDFIUM_TAG="chromium/8100"
PDFIUM_BASE_URL="https://github.com/bblanchon/pdfium-binaries/releases/download/${PDFIUM_TAG}"

# Tesseract models — tesseract-ocr/tessdata_fast @ main (2024-08-01).
# `fast` variants: best speed/size trade-off for the OCR-while-typing use
# case (see docs/packaging.md).
TESSDATA_COMMIT="87416418657359cb625c412a48b6e1d6d41c29bd"
TESSDATA_BASE_URL="https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/${TESSDATA_COMMIT}"
TESSDATA_ENG_SHA256="7d4322bd2a7749724879683fc3912cb542f19906c83bcc1a52132556427170b2"
TESSDATA_HUN_SHA256="35067e7cfe102dcdc953f9a758fdfaa6296b17a1ee6d874ee780fa306430b9fb"

# Per-platform PDFium pins: archive name, archive SHA-256, path of the
# library inside the archive, and the bundled file name it becomes.
PDFIUM_LINUX_ARCHIVE="pdfium-linux-x64.tgz"
PDFIUM_LINUX_ARCHIVE_SHA256="1c1894a12d4d96ee01400c3874444126254180c5c7d2ab628576b67f8120320a"
PDFIUM_LINUX_INNER="lib/libpdfium.so"
PDFIUM_LINUX_OUT="libpdfium.so"
PDFIUM_LINUX_LIB_SHA256="b8784cbd652ad2993332b7695e2c80f3a797f877fc47d9be97b66bca9639539e"

PDFIUM_MACOS_ARCHIVE="pdfium-mac-arm64.tgz"
PDFIUM_MACOS_ARCHIVE_SHA256="7ea647c7a7a9c1169be3f947000bc071ece2fade2cd6bd7e401e3675c6560cce"
PDFIUM_MACOS_INNER="lib/libpdfium.dylib"
PDFIUM_MACOS_OUT="libpdfium.dylib"
PDFIUM_MACOS_LIB_SHA256="38d2326d9bfa8ed935bcd757348244d96e1ea4b0e274d3ee789c5b922726e350"

PDFIUM_WINDOWS_ARCHIVE="pdfium-win-x64.tgz"
PDFIUM_WINDOWS_ARCHIVE_SHA256="51621bcc1d9be9ea448f4b84b0516862b928e3968d3fca899af1a6d6e2848d6d"
PDFIUM_WINDOWS_INNER="bin/pdfium.dll"
PDFIUM_WINDOWS_OUT="pdfium.dll"
PDFIUM_WINDOWS_LIB_SHA256="ae913f407e8d3f5cdbf08a9869564d647b13e132e01eb376c0a5a33b7a227a45"

# Glyphless font: the repository commits the exact production font
# (tests/fixtures/pdf.ttf, provenance /usr/share/tesseract-ocr/5/tessdata/
# pdf.ttf), so it is copied rather than downloaded.

# Tesseract 5.5.3 + Leptonica 1.87.0 — our own relocated prebuilts
# (issues #19/#42), built on GitHub runners by
# .github/workflows/native-libs.yml from these pinned upstream sources:
#   Leptonica 1.87.0 (2025-12-24):
#     https://github.com/DanBloomberg/leptonica/releases/download/1.87.0/leptonica-1.87.0.tar.gz
#     SHA-256 c73363397f96eb1295602bf44d708a994ad42046c791bf03ea0505d829bdb6a7
#   Tesseract 5.5.3 (2026-07-24):
#     https://github.com/tesseract-ocr/tesseract/archive/refs/tags/5.5.3.tar.gz
#     SHA-256 9218e62793116d42a9f6d14cd9348518b27f382096eea3d0f2d1a24616bb5884
# and published as per-OS archives on this repository's release tag
# `ocr-prebuilts-1` (bblanchon-style stable URLs; release notes record
# the build provenance). Each archive holds both libraries at its
# root, already named as the bundled slots. Relocation contracts:
#   linux64:   soname libleptonica.so, libtesseract rpath $ORIGIN
#   macos:     install names @loader_path/... (arm64)
#   windows64: tesseract.dll imports leptonica.dll by name, satisfied
#              by the leptonica-first preload (src/ocr/ffi.rs); static CRT
OCR_TAG="ocr-prebuilts-1"
OCR_BASE_URL="https://github.com/aron98/chilli-pdf/releases/download/${OCR_TAG}"

OCR_LINUX_ARCHIVE="chilli-ocr-linux64.tar.gz"
OCR_LINUX_ARCHIVE_SHA256="2c33789ea7d82023c4ce26a54c26b581f473bc6b60d87f3fbb84e515eb253089"
OCR_LINUX_TESSERACT_SHA256="a49c6a8c7da42138b32eadccff8bd1d9bf56395621fa6a416dcb10eaacade905"
OCR_LINUX_LEPTONICA_SHA256="7c63a93a476db4a15126601695e9a4e47e563f7296d0d86571b9411632a06ca9"

OCR_MACOS_ARCHIVE="chilli-ocr-macos.tar.gz"
OCR_MACOS_ARCHIVE_SHA256="4df9063c7d14b2ea78c58a3ef62dcdb6717f82b0ddf808972b1adf2a16b8e89a"
OCR_MACOS_TESSERACT_SHA256="acceed351467bb316448b28fa6dc282f93e27cfa0312c0ade755305dcc0527ad"
OCR_MACOS_LEPTONICA_SHA256="0184052ef347d88919697a859bed8378b87406a50d189d264ed180742dcccb37"

OCR_WINDOWS_ARCHIVE="chilli-ocr-windows64.tar.gz"
OCR_WINDOWS_ARCHIVE_SHA256="c8b83c26536f8a9e1ed11b9e0b45143ebb1f52f9fe3c77fbaaf5e59ad4cb03c6"
OCR_WINDOWS_TESSERACT_SHA256="70283aaca85f03ebf062f2ff618da7227506448371504bd8646ff91d09716e16"
OCR_WINDOWS_LEPTONICA_SHA256="dab8789d14004514c05e95b49db7c720a5acdc3ccd99ef1699e10dd884555344"

# ---------------------------------------------------------------------------

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OVERLAY="${ROOT}/assets/real/v1"

usage() {
  cat <<'USAGE'
Fetch the pinned, real bundled assets for one platform (issue #19).

Downloads the exact upstream artifacts named in the script's pin table,
verifies every download against its pinned SHA-256 (fail-closed), and
lays the platform's asset set out in the gitignored assets/real/v1/
overlay, which the next build embeds instead of the fixture bundle.

This is a PACKAGING-TIME step: it runs on the machine that builds a
release, never on the machine that runs chilli-pdf (the app never
touches the network).

Usage:
  scripts/fetch-assets [--platform linux64|macos|windows64]

--platform defaults to the machine running the script; 'macos' pins the
arm64 artifacts (that is what the release workflow builds on).

Tesseract and Leptonica come from this repository's ocr-prebuilts-1
release: our own relocated prebuilts built from pinned upstream sources
by the native-libs workflow (see docs/packaging.md).
USAGE
}

die() {
  echo "fetch-assets: ERROR: $*" >&2
  exit 1
}

note() {
  echo "fetch-assets: $*"
}

# Portable SHA-256 (macOS has no sha256sum; its shasum speaks the same hex).
sha256_hex() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | cut -d' ' -f1
  else
    shasum -a 256 "$1" | cut -d' ' -f1
  fi
}

# Fail-closed checksum verification.
verify_sha256() {
  local file="$1" expected="$2" actual
  actual="$(sha256_hex "$file")"
  if [ "${actual}" != "${expected}" ]; then
    die "SHA-256 mismatch for ${file}: expected ${expected}, got ${actual}."
  fi
}

download() {
  local url="$1" out="$2"
  note "downloading ${url}"
  curl -fsSL --retry 3 -o "${out}" "${url}" || die "download failed: ${url}"
}

detect_platform() {
  case "$(uname -s)" in
    Linux) echo "linux64" ;;
    Darwin) echo "macos" ;;
    MINGW* | MSYS* | CYGWIN*) echo "windows64" ;;
    *) return 1 ;;
  esac
}

platform=""
while [ $# -gt 0 ]; do
  case "$1" in
    --help | -h)
      usage
      exit 0
      ;;
    --platform)
      [ $# -ge 2 ] || die "--platform requires a value (linux64|macos|windows64)"
      case "$2" in
        linux64 | macos | windows64) platform="$2" ;;
        *) die "unknown platform '$2' (expected linux64|macos|windows64)" ;;
      esac
      shift 2
      ;;
    *)
      die "unknown argument '$1' (expected --platform <linux64|macos|windows64>)"
      ;;
  esac
done
if [ -z "${platform}" ]; then
  platform="$(detect_platform)" || die "cannot autodetect the platform; pass --platform <linux64|macos|windows64>"
fi

case "${platform}" in
  linux64)
    pdfium_archive="${PDFIUM_LINUX_ARCHIVE}"
    pdfium_archive_sha256="${PDFIUM_LINUX_ARCHIVE_SHA256}"
    pdfium_inner="${PDFIUM_LINUX_INNER}"
    pdfium_out="${PDFIUM_LINUX_OUT}"
    pdfium_lib_sha256="${PDFIUM_LINUX_LIB_SHA256}"
    ocr_archive="${OCR_LINUX_ARCHIVE}"
    ocr_archive_sha256="${OCR_LINUX_ARCHIVE_SHA256}"
    ocr_tesseract_sha256="${OCR_LINUX_TESSERACT_SHA256}"
    ocr_leptonica_sha256="${OCR_LINUX_LEPTONICA_SHA256}"
    ocr_tesseract_out="libtesseract.so"
    ocr_leptonica_out="libleptonica.so"
    ;;
  macos)
    pdfium_archive="${PDFIUM_MACOS_ARCHIVE}"
    pdfium_archive_sha256="${PDFIUM_MACOS_ARCHIVE_SHA256}"
    pdfium_inner="${PDFIUM_MACOS_INNER}"
    pdfium_out="${PDFIUM_MACOS_OUT}"
    pdfium_lib_sha256="${PDFIUM_MACOS_LIB_SHA256}"
    ocr_archive="${OCR_MACOS_ARCHIVE}"
    ocr_archive_sha256="${OCR_MACOS_ARCHIVE_SHA256}"
    ocr_tesseract_sha256="${OCR_MACOS_TESSERACT_SHA256}"
    ocr_leptonica_sha256="${OCR_MACOS_LEPTONICA_SHA256}"
    ocr_tesseract_out="libtesseract.dylib"
    ocr_leptonica_out="libleptonica.dylib"
    ;;
  windows64)
    pdfium_archive="${PDFIUM_WINDOWS_ARCHIVE}"
    pdfium_archive_sha256="${PDFIUM_WINDOWS_ARCHIVE_SHA256}"
    pdfium_inner="${PDFIUM_WINDOWS_INNER}"
    pdfium_out="${PDFIUM_WINDOWS_OUT}"
    pdfium_lib_sha256="${PDFIUM_WINDOWS_LIB_SHA256}"
    ocr_archive="${OCR_WINDOWS_ARCHIVE}"
    ocr_archive_sha256="${OCR_WINDOWS_ARCHIVE_SHA256}"
    ocr_tesseract_sha256="${OCR_WINDOWS_TESSERACT_SHA256}"
    ocr_leptonica_sha256="${OCR_WINDOWS_LEPTONICA_SHA256}"
    ocr_tesseract_out="tesseract.dll"
    ocr_leptonica_out="leptonica.dll"
    ;;
  *) die "unhandled platform '${platform}'" ;;
esac

# A fresh overlay keeps the bundle lean and platform-pure: leftovers of
# an earlier fetch (or of another platform) must never leak into a build.
rm -rf "${ROOT}/assets/real"
mkdir -p "${OVERLAY}/tessdata"

# --- PDFium: download the pinned archive, verify it, unpack, verify the
# --- library inside it, and place it under its bundled name.
workdir="$(mktemp -d)"
trap 'rm -rf "${workdir}"' EXIT

archive="${workdir}/${pdfium_archive}"
download "${PDFIUM_BASE_URL}/${pdfium_archive}" "${archive}"
verify_sha256 "${archive}" "${pdfium_archive_sha256}"

tar -xzf "${archive}" -C "${workdir}"
pdfium_lib="${workdir}/${pdfium_inner}"
[ -f "${pdfium_lib}" ] || die "expected '${pdfium_inner}' inside the PDFium archive"
verify_sha256 "${pdfium_lib}" "${pdfium_lib_sha256}"
cp "${pdfium_lib}" "${OVERLAY}/${pdfium_out}"
note "placed ${pdfium_out} ($(stat -c%s "${pdfium_lib}" 2>/dev/null || stat -f%z "${pdfium_lib}") bytes)"

# --- Traineddata models: download and verify both pinned models.
for model in eng hun; do
  case "${model}" in
    eng) expected="${TESSDATA_ENG_SHA256}" ;;
    hun) expected="${TESSDATA_HUN_SHA256}" ;;
  esac
  out="${OVERLAY}/tessdata/${model}.traineddata"
  download "${TESSDATA_BASE_URL}/${model}.traineddata" "${out}"
  verify_sha256 "${out}" "${expected}"
  note "placed tessdata/${model}.traineddata"
done

# --- Glyphless font: the committed production copy, not a download.
cp "${ROOT}/tests/fixtures/pdf.ttf" "${OVERLAY}/pdf.ttf"
note "placed pdf.ttf (the committed production glyphless font)"

# --- Tesseract & Leptonica: our own relocated prebuilts (pin table
# --- above; provenance and relocation contracts in docs/packaging.md).
# --- Download the pinned archive, verify it, unpack to a scratch dir,
# --- verify BOTH libraries inside it, and copy them under their
# --- bundled slot names. Fail-closed end to end like the PDFium block.
ocr_archive_file="${workdir}/${ocr_archive}"
download "${OCR_BASE_URL}/${ocr_archive}" "${ocr_archive_file}"
verify_sha256 "${ocr_archive_file}" "${ocr_archive_sha256}"

ocr_dir="${workdir}/ocr"
mkdir -p "${ocr_dir}"
tar -xzf "${ocr_archive_file}" -C "${ocr_dir}"
for lib in "${ocr_tesseract_out}" "${ocr_leptonica_out}"; do
  [ -f "${ocr_dir}/${lib}" ] || die "expected '${lib}' inside the OCR prebuilts archive"
done
verify_sha256 "${ocr_dir}/${ocr_tesseract_out}" "${ocr_tesseract_sha256}"
verify_sha256 "${ocr_dir}/${ocr_leptonica_out}" "${ocr_leptonica_sha256}"
for lib in "${ocr_tesseract_out}" "${ocr_leptonica_out}"; do
  cp "${ocr_dir}/${lib}" "${OVERLAY}/${lib}"
  note "placed ${lib} ($(stat -c%s "${ocr_dir}/${lib}" 2>/dev/null || stat -f%z "${ocr_dir}/${lib}") bytes)"
done

# --- Regenerate the overlay's manifest (one command, canonical format).
note "regenerating assets/real/manifest.txt"
(
  cd "${ROOT}"
  cargo run --example update_asset_manifest -- --dir assets/real/v1 --out assets/real/manifest.txt
)

note "done: real-asset overlay for '${platform}' is ready in assets/real/ (gitignored)."
note "the next build embeds it (build.rs sets --cfg chilli_real_assets)."
