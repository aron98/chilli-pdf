# Rust
/target
**/*.rs.bk

# Bundled runtime payloads, not source-controlled (release packaging)
/dist

# NOTE: /assets IS source-controlled (issue #9). assets/v1 holds the
# embedded asset bundle (fixture libs + traineddata now, real binaries
# dropped in later — data-only) and assets/manifest.txt is the generated
# SHA-256 manifest both the build and the tests depend on.

# Fetched real-asset overlay (issue #19): scripts/fetch-assets downloads
# the pinned multi-megabyte libraries and models here; they are embedded
# into release binaries at build time and never committed.
/assets/real

# Local experiments and scratch output
/scratch
*.log

# OS / editor noise
.DS_Store
Thumbs.db

# Agent / session state
.opencode/
